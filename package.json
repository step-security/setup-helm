{
   "name": "@step-security/setuphelm",
   "version": "5.1.0",
   "private": true,
   "description": "Setup helm",
   "author": "step-security",
   "publisher": "step-security",
   "license": "MIT",
   "type": "module",
   "dependencies": {
      "@actions/core": "^3.0.1",
      "@actions/tool-cache": "4.0.0",
      "axios": "^1.20.0"
   },
   "main": "dist/index.js",
   "scripts": {
      "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "test-coverage": "vitest run --coverage",
      "format": "prettier --write .",
      "format-check": "prettier --check ."
   },
   "devDependencies": {
      "@types/node": "^26.6.6",
      "esbuild": "^0.28.1",
      "prettier": "^3.9.10",
      "typescript": "^7.0.2",
      "vitest": "^5"
   },
   "homepage": "https://github.com/step-security/setup-helm#readme",
   "repository": {
      "type": "git",
      "url": "https://github.com/step-security/setup-helm.git"
   },
   "bugs": {
      "url": "https://github.com/step-security/setup-helm/issues"
   },
   "engines": {
      "node": ">=24",
      "npm": ">=11"
   }
}
